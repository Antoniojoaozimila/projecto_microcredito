{
	email {$CADDY_EMAIL}
}

# Quem abrir pelo IP é enviado para o endereço com HTTPS (Let's Encrypt via sslip.io).
http://{$IP_PUBLICO} {
	redir https://{$DOMINIO}{uri} permanent
}

{$DOMINIO} {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api* {
		reverse_proxy backend:3000
	}

	handle /uploads* {
		reverse_proxy backend:3000
	}

	handle /m* {
		reverse_proxy mobile:80
	}

	handle {
		reverse_proxy frontend:80
	}
}
