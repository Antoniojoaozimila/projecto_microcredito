# Copie para .env no servidor OU cole estas linhas no Docker Manager
# (Compose → Environment variables). Nunca envie este ficheiro preenchido para o GitHub.

# Endereço público (sslip.io aponta automaticamente para o IP da VPS)
DOMINIO=148-230-115-150.sslip.io
IP_PUBLICO=148.230.115.150
CADDY_EMAIL=o-seu-email@dominio.com

# MySQL (dentro do Docker; a porta 3306 NÃO fica exposta à internet)
DB_NOME=microcredito
DB_UTILIZADOR=root
DB_SENHA=troque-por-uma-senha-forte

# API
JWT_SEGREDO=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRA=12h
CORS_ORIGENS=https://148-230-115-150.sslip.io,http://148.230.115.150
SEMEAR_ADMIN_TESTE=false
ADMIN_SENHA_INICIAL=troque-esta-senha-no-primeiro-acesso

# Versão web do telemóvel e APK nativo: a mesma API do site
EXPO_PUBLIC_API_URL=https://148-230-115-150.sslip.io
